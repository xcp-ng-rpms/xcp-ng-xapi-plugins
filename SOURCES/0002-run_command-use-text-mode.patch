From cf8f86d6f8fb29c83d3b0358a490d968735e079e Mon Sep 17 00:00:00 2001
From: Yann Dirson <yann.dirson@vates.tech>
Date: Thu, 12 Nov 2026 12:14:31 +0100
Subject: [PATCH 2/7] run_command: use text mode

All commands currently used appear to require text mode.  We may some
day make this a run_command parameter.

Signed-off-by: Yann Dirson <yann.dirson@vates.tech>
---
 SOURCES/etc/xapi.d/plugins/xcpngutils/__init__.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/SOURCES/etc/xapi.d/plugins/xcpngutils/__init__.py b/SOURCES/etc/xapi.d/plugins/xcpngutils/__init__.py
index dfb9669..c518509 100644
--- a/SOURCES/etc/xapi.d/plugins/xcpngutils/__init__.py
+++ b/SOURCES/etc/xapi.d/plugins/xcpngutils/__init__.py
@@ -76,7 +76,8 @@ class ProcessException(subprocess.CalledProcessError):
         return "Command '%s' failed with code: %d" % (self.cmd, self.returncode)
 
 def run_command(command, check=True):
-    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                               text=True)
     stdout, stderr = process.communicate()
     code = process.returncode
     if check and code != 0:
-- 
2.47.3

